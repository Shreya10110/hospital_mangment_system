# Copy this file to .env and replace every value before running the application.
# Recommended on IPv4 networks: copy the Session pooler URI from Supabase Connect.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
GOOGLE_API_KEY=replace-with-your-google-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated deployed frontend origins; never use * with credentialed requests.
CORS_ORIGINS=https://your-frontend.example.com
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-unique-password
